# Example TLS termination + reverse proxy on EC2 (Amazon Linux: /etc/nginx/conf.d/).
# Replace server_name values and SSL paths. Upstreams assume Docker publishes 5081 (API) and 5090 (CDN)
# on the EC2 host loopback only (bind 127.0.0.1 in docker-compose ports for production).

upstream plzbuyme_api {
    server 127.0.0.1:5081;
    keepalive 32;
}

upstream plzbuyme_cdn {
    server 127.0.0.1:5090;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name api.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;

    location / {
        proxy_pass         http://plzbuyme_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

server {
    listen 443 ssl http2;
    server_name cdn.example.com;

    ssl_certificate     /etc/letsencrypt/live/cdn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cdn.example.com/privkey.pem;
    client_max_body_size 50m;

    location / {
        proxy_pass         http://plzbuyme_cdn;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name api.example.com cdn.example.com;
    return 301 https://$host$request_uri;
}
