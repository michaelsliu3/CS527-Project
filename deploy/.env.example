# Copy to .env in this folder (deploy/.env). Used by docker compose.

# RDS: create MySQL 8 instance + database "plzbuyme" in AWS console (or use docker-compose.local-mysql.yml).
# Example: Server=mydb.xxxxx.us-east-1.rds.amazonaws.com;Database=plzbuyme;User=admin;Password=...;
CONNECTION_STRING=

# Browser-facing CDN base (stored in item image URLs). No trailing slash.
# Single EC2 host + nginx: use your public IP or DNS, e.g. http://3.80.65.189
# Must match GitHub var VITE_CDN_URL (and same origin as VITE_API_URL without /api) for the SPA build.
CDN_PUBLIC_URL=https://cdn.example.com

# Comma-separated list of browser origins allowed to call the API and CDN (your SPA origin).
# Include https://your-cloudfront-or-s3-website URL and any dev origins you still use.
CORS_ORIGINS=https://app.example.com,http://localhost:5173

# JWT signing key: at least 32 characters; generate a random secret for production.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Optional overrides (defaults match appsettings.json)
# JWT_ISSUER=PlzBuyMe
# JWT_AUDIENCE=PlzBuyMeUsers
# JWT_EXPIRES_MINUTES=60

# --- docker-compose.ecr.yml (CI/CD or manual ECR pulls) ---
# ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# IMAGE_TAG=latest
# ECR_REPOSITORY_API=plzbuyme-api
# ECR_REPOSITORY_CDN=plzbuyme-cdn
