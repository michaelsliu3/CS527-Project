cat .env
# Copy to .env in this folder (deploy/.env). Used by docker compose.

# RDS: create MySQL 8 instance + database "plzbuyme" in AWS console (or use docker-compose.local-mysql.yml).
# Example: Server=mydb.xxxxx.us-east-1.rds.amazonaws.com;Database=plzbuyme;User=admin;Password=...;
CONNECTION_STRING=Server=plzbuyme.c0v0me80k9pl.us-east-1.rds.amazonaws.com;Port=3306;Database=plzbuyme;User=admin;Password=password;
CDN_PUBLIC_URL=http://3.80.65.189
CORS_ORIGINS=http://3.80.65.189:5173,http://3.80.65.189,http://localhost:5173
JWT_KEY=YourSuperSecretKeyThatIsAtLeast32Characters!

# Optional overrides (defaults match appsettings.json)
