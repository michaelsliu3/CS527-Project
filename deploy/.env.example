# Copy to deploy/.env. Used by docker compose (same directory as docker-compose*.yml).

# RDS: create MySQL 8 instance + database "plzbuyme" in AWS console (or use docker-compose.local-mysql.yml).
# Example: Server=mydb.xxxxx.us-east-1.rds.amazonaws.com;Database=plzbuyme;User=admin;Password=...;
CONNECTION_STRING=Server=plzbuyme.c0v0me80k9pl.us-east-1.rds.amazonaws.com;Port=3306;Database=plzbuyme;User=admin;Password=password;
CDN_PUBLIC_URL=http://3.80.65.189
CORS_ORIGINS=http://3.80.65.189:5173,http://3.80.65.189,http://localhost:5173
JWT_KEY=YourSuperSecretKeyThatIsAtLeast32Characters!

# Optional overrides (defaults match appsettings.json)
# JWT_ISSUER=PlzBuyMe
# JWT_AUDIENCE=PlzBuyMeUsers
# JWT_EXPIRES_MINUTES=60

# --- docker-compose.ecr.yml (required for ECR-based deploy) ---
# ECR_REGISTRY must be set or compose warns and image names are wrong.
# ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# IMAGE_TAG=latest
# ECR_REPOSITORY_API=plzbuyme-api
# ECR_REPOSITORY_CDN=plzbuyme-cdn
#
# Host path to gt7-car-thumbnails.manifest.json (bind-mounted into API container). Default in
# compose is /var/lib/plzbuyme/gt7-car-thumbnails.manifest.json — copy the file there, or set:
# GT7_MANIFEST_HOST=/full/path/on/ec2/gt7-car-thumbnails.manifest.json