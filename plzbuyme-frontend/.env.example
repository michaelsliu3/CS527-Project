VITE_API_URL=http://localhost:5081/api
VITE_CDN_URL=http://localhost:5090
# EC2 / CloudFront: set both; for a single public host use the same origin for VITE_CDN_URL as for API (without /api).
# In `npm run dev`, if VITE_CDN_URL is omitted, the app uses http://localhost:5090 (not the API port).
# In production builds, if VITE_CDN_URL is omitted, the app uses the VITE_API_URL origin without /api.
